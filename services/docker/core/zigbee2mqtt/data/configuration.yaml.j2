{# Clés gérées par Ansible, fusionnées dans configuration.yaml (tasks/zigbee2mqtt_config.yml) :
   Zigbee2MQTT y conserve ses propres sections (devices, groups, réglages de l'interface).
   Sur un fichier existant, version et network_key ne sont jamais écrits ; network_key doit
   déjà être égale à celle de Bitwarden. Retirer une clé d'ici ne la retire pas du fichier. #}
homeassistant:
  enabled: true
frontend:
  enabled: true
mqtt:
  server: mqtt://mosquitto:1883
  user: {{ mqtt_user }}
  password: {{ mqtt_password }}
serial:
  port: {{ smlight_serial_url }}
  baudrate: 115200
  adapter: {{ smlight_adapter }}
  disable_led: false
advanced:
  transmit_power: 20
  network_key: {{ z2m_network_key | to_json }}
version: 5
