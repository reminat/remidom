#!/bin/sh
# Géré par Ansible (rôle restic_backup). Lance restic (image épinglée) pour la sauvegarde
# « {{ restic_backup_name }} » : repository et mot de passe lus dans {{ restic_backup_config_dir }} (root, 0600).
#
#   restic-{{ restic_backup_name }} snapshots | check | backup … | ls … | stats …
#   restic-{{ restic_backup_name }} restore-to <dossier vide> <snapshot> [options de restore]
#
# Les données sont montées en lecture seule ; seule la restauration écrit, dans le dossier cible.
set -eu

IMAGE='{{ restic_backup_image }}'
CONF='{{ restic_backup_config_dir }}/{{ restic_backup_name }}'
CACHE='{{ restic_backup_cache_dir }}/{{ restic_backup_name }}'

extra=""
caps="--cap-add DAC_READ_SEARCH"
if [ "${1:-}" = "restore-to" ]; then
  target="${2:-}"
  [ -n "$target" ] && [ -d "$target" ] && [ ! -L "$target" ] && [ -z "$(ls -A -- "$target")" ] || {
    echo "restore-to : un dossier existant et vide est requis" >&2; exit 2; }
  case "$target" in /srv/docker/*|/|/etc*|/usr*|/var/lib/docker*) echo "restore-to : cible refusée : $target" >&2; exit 2 ;; esac
  shift 2
  set -- restore "$@" --target /restore
  extra="-v $target:/restore"
  caps="--cap-add DAC_READ_SEARCH --cap-add DAC_OVERRIDE --cap-add CHOWN --cap-add FOWNER"
fi

# shellcheck disable=SC2086
exec /usr/bin/docker run --rm --pull never --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,size=256m \
  --cap-drop ALL $caps --security-opt no-new-privileges \
  --hostname '{{ restic_backup_host }}' \
  --env-file "$CONF.env" \
  -e RESTIC_PASSWORD_FILE=/run/secrets/restic_password -v "$CONF.password:/run/secrets/restic_password:ro" \
  -e RESTIC_CACHE_DIR=/cache -v "$CACHE:/cache" \
{% for path in restic_backup_paths %}
  -v '{{ path }}:{{ path }}:ro' \
{% endfor %}
  $extra "$IMAGE" "$@"
