variable "pm_node" {
  type = string
}

variable "vm_name" {
  type = string
}

variable "vm_template_id" {
  type = number
}

variable "vm_cores" {
  type    = number
  default = 2
}

variable "vm_memory_mb" {
  type    = number
  default = 4096
}

variable "vm_disk_gb" {
  type    = number
  default = 40
}

variable "vm_storage" {
  type    = string
  default = "local-lvm"
}

variable "vm_bridge" {
  type    = string
  default = "vmbr0"
}

variable "ssh_authorized_keys" {
  type      = list(string)
  sensitive = true

  validation {
    condition     = length(var.ssh_authorized_keys) > 0
    error_message = "ssh_authorized_keys must contain at least one SSH public key."
  }
}

variable "user_data_template_path" {
  type        = string
  description = "Path to the cloud-init user-data Terraform template (.tftpl)."
}

# Optional firmware and network settings. The null defaults leave the generated
# configuration unchanged for the existing callers (Docker hosts).

variable "vm_bios" {
  type        = string
  default     = null
  description = "BIOS implementation: \"seabios\" or \"ovmf\" (UEFI). null = provider default."

  validation {
    condition     = var.vm_bios == null || contains(["seabios", "ovmf"], coalesce(var.vm_bios, "seabios"))
    error_message = "vm_bios must be null, \"seabios\" or \"ovmf\"."
  }
}

variable "vm_machine" {
  type        = string
  default     = null
  description = "Machine type, e.g. \"q35\". null = provider default."
}

variable "vm_efi_disk" {
  type = object({
    datastore_id      = optional(string)
    type              = optional(string, "4m")
    pre_enrolled_keys = optional(bool, false)
  })
  default     = null
  description = "EFI disk, required with vm_bios = \"ovmf\". datastore_id defaults to vm_storage."
}

variable "vm_mac_address" {
  sensitive   = true
  type        = string
  default     = null
  description = "Fixed MAC address of the network device (DHCP reservation). null = generated by Proxmox."

  validation {
    condition     = var.vm_mac_address == null || can(regex("^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$", coalesce(var.vm_mac_address, "00:00:00:00:00:00")))
    error_message = "vm_mac_address must be null or a MAC address like AA:BB:CC:DD:EE:FF."
  }
}

variable "ssh_config_path" {
  type        = string
  default     = "/etc/ssh/sshd_config.d/99-homelab.conf"
  description = "Fragment SSH cloud-init ; défaut conservé pour les consommateurs existants."
}
